{
  "mcpServers": {
    "casper-nctl-2-docker-http": {
      "url": "http://127.0.0.1:8788/mcp"
    },
    "casper-nctl-2-docker-stdio": {
      "command": "cargo",
      "args": [
        "run",
        "--manifest-path",
        "mcp/Cargo.toml",
        "--quiet",
        "--"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "NCTL_DOCKER_ROOT": "${workspaceFolder}"
      }
    }
  }
}
